{
  "manifest_version": 3,
  "name": "AliReturn",
  "version": "1.2.6",
  "description": "Export actual AliExpress refund amounts for a date range.",
  "permissions": ["storage", "downloads", "tabs", "debugger"],
  "host_permissions": ["https://*.aliexpress.com/*"],
  "action": {
    "default_title": "AliReturn",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": [
      "https://*.aliexpress.com/p/refund-dispute/*",
      "https://*.aliexpress.com/p/reverse-pages/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
